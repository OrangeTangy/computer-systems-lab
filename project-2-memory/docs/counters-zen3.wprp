  <HardwareCounter Id="Counters" Strict="true"><MicroArchitecturalConfigId Value="Zen3"/><Counters><Counter Value="LabL1DTLBMiss"/><Counter Value="LabL2DTLBMiss"/><Counter Value="LabDemandDRAMFill"/><Counter Value="InstructionRetired"/><Counter Value="TotalCycles"/></Counters><Events><Event Value="CSwitch"/></Events></HardwareCounter>
  <Profile Id="LabCountersZen3.Verbose.File" Name="LabCountersZen3" Description="Ryzen 5500 cache/TLB and cycles; validate attribution before use" LoggingMode="File" DetailLevel="Verbose">
