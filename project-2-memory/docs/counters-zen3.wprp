 <Profiles>
  <SystemCollector Id="Collector" Name="LabCounterCollector"><BufferSize Value="1024"/><Buffers Value="64"/></SystemCollector>
  <SystemProvider Id="Provider"><Keywords><Keyword Value="ProcessThread"/><Keyword Value="Loader"/><Keyword Value="CSwitch"/></Keywords></SystemProvider>
  <MicroArchitecturalConfig Id="Zen3"><ProfileSources Architecture="AMD" Family="25" Model="80" Description="Ryzen 5500 Zen 3">
   <ProfileSource Name="LabL1DTLBMiss" Event="0x45" Unit="0xFF" Interval="0x10000" Persist="false"/>
   <ProfileSource Name="LabL2DTLBMiss" Event="0x45" Unit="0xF0" Interval="0x10000" Persist="false"/>
   <ProfileSource Name="LabDemandDRAMFill" Event="0x43" Unit="0x08" Interval="0x10000" Persist="false"/>
