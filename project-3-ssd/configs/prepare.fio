[global]
ioengine=windowsaio
filename=disposable-fio-test.bin
direct=1
thread=1
numjobs=1
group_reporting=1
size=2G
randrepeat=1
randseed=4320
refill_buffers=1
buffer_compress_percentage=0
percentile_list=50:95:99:99.9
lat_percentiles=1
clat_percentiles=1
rw=write
bs=1M
iodepth=8
end_fsync=1

[prepare]
