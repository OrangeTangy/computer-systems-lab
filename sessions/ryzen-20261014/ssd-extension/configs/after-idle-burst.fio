[global]
ioengine=windowsaio
direct=1
thread=1
numjobs=1
group_reporting=1
randrepeat=1
randseed=14320
refill_buffers=1
lat_percentiles=1
clat_percentiles=1
percentile_list=50:95:99:99.9
filename=disposable.bin
size=2G
buffer_compress_percentage=0
rw=write
bs=128k
iodepth=32
time_based=1
runtime=20
write_bw_log=idle
write_lat_log=idle
log_avg_msec=1000

[after-idle-burst]
