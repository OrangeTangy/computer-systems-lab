[global]
ioengine=windowsaio
direct=1
thread=1
numjobs=1
group_reporting=1
randrepeat=1
randseed=14320
refill_buffers=1
lat_percentiles=1
clat_percentiles=1
percentile_list=50:95:99:99.9
filename=sustained.bin
size=40G
buffer_compress_percentage=0
rw=write
bs=128k
iodepth=32
runtime=900
write_bw_log=sustained
write_lat_log=sustained
log_avg_msec=1000

[sustained-write]
