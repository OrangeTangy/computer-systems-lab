[global]
ioengine=windowsaio
direct=1
thread=1
numjobs=1
group_reporting=1
randrepeat=1
randseed=14320
refill_buffers=1
lat_percentiles=1
clat_percentiles=1
percentile_list=50:95:99:99.9
filename=disposable.bin
size=16M
buffer_compress_percentage=0
rw=write
bs=4k
iodepth=1
verify=crc32c
do_verify=1
verify_fatal=1

[verify]
