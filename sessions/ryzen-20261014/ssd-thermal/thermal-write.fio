[global]
ioengine=windowsaio
direct=1
thread=1
numjobs=1
filename=thermal.bin
size=30G
rw=write
bs=128k
iodepth=32
refill_buffers=1
buffer_compress_percentage=0
lat_percentiles=1
percentile_list=50:95:99:99.9
write_bw_log=thermal
write_lat_log=thermal
log_avg_msec=1000

[thermal-write]
